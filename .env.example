# Copy to .env (or export in your shell). All values are optional for local dev.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./agile.db
TOKEN_TTL_MINUTES=480

# Background worker
WORKER_ENABLED=1
WORKER_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_BASE_SECONDS=2
DUE_SCAN_INTERVAL_SECONDS=3600

# Demo knob: 0.0-1.0 chance that the simulated e-mail provider fails (shows retries)
DELIVERY_FAILURE_RATE=0
